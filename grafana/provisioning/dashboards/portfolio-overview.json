{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Portfolio System Overview",
  "uid": "portfolio-overview",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Containers dang chay",
      "description": "Tong so container dang hoat dong",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "count(count by (name)(container_last_seen{name!=\"\"}))", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MySQL Status",
      "description": "1 = online, 0 = offline",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFFLINE" }, "1": { "text": "ONLINE" } } }
          ]
        }
      },
      "targets": [ { "expr": "mysql_up", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nginx Requests/s",
      "description": "So request moi giay qua Nginx",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "expr": "rate(nginx_http_requests_total[1m])", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "MySQL Queries/s",
      "description": "So query MySQL moi giay",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[1m])", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU Host (%)",
      "description": "Phan tram CPU toan may chu",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RAM Host (used %)",
      "description": "Phan tram RAM da su dung",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU su dung theo container (%)",
      "description": "Ti le CPU cua tung container theo thoi gian",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name!=\"\"}[2m])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RAM su dung theo container (MB)",
      "description": "Bo nho RAM cua tung container theo thoi gian",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "mbytes" } },
      "targets": [
        {
          "expr": "sum by (name)(container_memory_usage_bytes{name!=\"\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Nginx Connections va Requests",
      "description": "So ket noi hien tai va request moi giay qua Nginx",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active connections",
          "refId": "A"
        },
        {
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "Requests/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "MySQL: Queries va Connections",
      "description": "Toc do query va so ket noi MySQL theo thoi gian",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "Queries/s",
          "refId": "A"
        },
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Threads connected",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network I/O theo container (bytes/s)",
      "description": "Luong mang vao/ra cua tung container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "sum by (name)(rate(container_network_receive_bytes_total{name!=\"\"}[1m]))",
          "legendFormat": "RX {{name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (name)(rate(container_network_transmit_bytes_total{name!=\"\"}[1m]))",
          "legendFormat": "TX {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk I/O container (bytes/s)",
      "description": "Toc do doc/ghi dia cua tung container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "sum by (name)(rate(container_fs_reads_bytes_total{name!=\"\"}[1m]))",
          "legendFormat": "Read {{name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (name)(rate(container_fs_writes_bytes_total{name!=\"\"}[1m]))",
          "legendFormat": "Write {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Logs tap trung (Loki) — Tat ca container",
      "description": "Hien thi log real-time cua toan bo container trong stack",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        { "expr": "{job=\"docker\"}", "refId": "A" }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" }
      }
    ]
  }
}
